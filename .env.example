# Copier en .env pour surcharger les valeurs de développement.
# Sans .env, compose.yml et settings.py utilisent déjà ces valeurs par défaut.
#
# Compose lit ce fichier automatiquement. Le process Django local, lui, ne le lit
# pas : pour surcharger côté Django, exporte les variables dans ton shell
# (`set -a; source .env; set +a`) ou renseigne-les dans ton IDE.

POSTGRES_DB=qisae
POSTGRES_USER=qisae
POSTGRES_PASSWORD=qisae_dev
POSTGRES_HOST=localhost
# À changer si un autre Postgres occupe déjà le 5432.
POSTGRES_PORT=5432

# Laissées commentées volontairement : une variable définie mais VIDE écrase le
# défaut de settings.py. Avec DJANGO_SECRET_KEY vide, `manage.py check` passe
# quand même (l'accès est paresseux) mais la première requête lève
# ImproperlyConfigured. Décommenter en renseignant une valeur — la clé est
# obligatoire en production.
#DJANGO_SECRET_KEY=
#DJANGO_DEBUG=1
#DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
