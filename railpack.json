{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "22",
    "python": "3.13"
  },
  "steps": {
    "build": {
      "inputs": [{ "step": "packages:mise" }],
      "commands": [
        { "src": ".", "dest": "." },
        "python -m venv /app/.venv",
        { "path": "/app/.venv/bin" },
        "bash build.sh"
      ]
    }
  },
  "deploy": {
    "inputs": [
      { "step": "packages:mise", "include": ["/mise/shims", "/mise/installs"] },
      { "step": "build", "include": ["."] }
    ],
    "paths": ["/app/.venv/bin"],
    "startCommand": "bash deploiement.sh && cd backend && gunicorn config.wsgi:application --bind 0.0.0.0:$PORT"
  }
}
